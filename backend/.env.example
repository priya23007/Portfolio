# ==========================================
# PORTFOLIO BACKEND CONFIGURATION
# ==========================================

# 1. MongoDB Database Cluster Configuration (NoSQL)
# Provide your MongoDB Atlas connection string below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio_db

# 2. Admin Security & Authentication (JWT)
JWT_SECRET=replace_with_a_long_random_secret_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@portfolio.com
ADMIN_INITIAL_PASSWORD=choose_a_strong_password

# 3. Cloudinary Image & Document Storage
# Get your credentials at: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 4. Google SMTP Email Notifications
# For Google SMTP, use your Gmail and generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password
SMTP_FROM_NAME="Portfolio Inquiry System"
# The email address that will receive client enquiry submissions:
NOTIFICATION_RECEIVER_EMAIL=your_email@gmail.com

# 5. Frontend Origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
